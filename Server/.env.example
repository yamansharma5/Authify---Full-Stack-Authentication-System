# ─────────────────────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file to git!
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=3000

# JWT — use a long, random secret (at least 32 characters)
JWT_SECRET=your_production_jwt_secret_at_least_32_chars

# MongoDB Atlas — get this from your Atlas dashboard > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# DO NOT include the database name here — it's appended in config/mongodb.js
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net

# Brevo (previously Sendinblue) SMTP
# Get from: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_password_key

# The "From" address shown in outgoing emails (must be verified in Brevo)
SENDER_EMAIL=noreply@yourdomain.com
